# SQLAlchemy database URL. Defaults to local SQLite if unset.
# On Railway, reference the Postgres service instead: ${{Postgres.DATABASE_URL}}
DATABASE_URL=sqlite:///./patients.db

# Set to true to insert the 2 demo patients on startup if they're absent.
SEED_ON_STARTUP=false

# Optional shared secret; if set, Vapi must send it as the X-Vapi-Secret
# header on tool-call webhooks (configure the same value in the Vapi
# assistant's server settings).
VAPI_WEBHOOK_SECRET=

# Vapi PRIVATE key (not the public key) — used only by the setup scripts to
# create the assistant. Never read at request time by the API.
VAPI_API_KEY=

# Public URL of this API, used as the tool webhook target.
PUBLIC_BASE_URL=

# LLM backing the voice agent. The provider's own API key is stored in the
# Vapi dashboard under Provider Keys, never in this repo.
LLM_PROVIDER=google
LLM_MODEL=gemini-2.0-flash
